# Google Earth Engine (optional). Without these, the app runs on Microsoft
# Planetary Computer data only and the Global Mangrove Watch layer is disabled.
#
# Paste the whole service account key JSON on one line...
GEE_SERVICE_ACCOUNT_JSON=
# ...or base64-encode it instead (handy on hosts that mangle newlines):
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("key.json"))
#   macOS/Linux: base64 -w0 key.json
GEE_SERVICE_ACCOUNT_JSON_BASE64=

# Cloud project registered for Earth Engine. Defaults to the key's project_id.
GEE_PROJECT=
