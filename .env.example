# Mangrove Atlas needs no API keys.
#
# Optional: where the browser loads the Global Mangrove Watch tiles from.
# Defaults to the published copy on GitHub Pages:
#   https://flora-carbon-ai.github.io/mangrove-atlas/gmw-v4112
# For a local build exported with pipeline/export_dir.py into public/data/gmw-v4112:
# NEXT_PUBLIC_GMW_TILES_URL=/data/gmw-v4112
NEXT_PUBLIC_GMW_TILES_URL=
