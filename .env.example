# Google Earth Engine (optional). Without these, the app runs on Microsoft
# Planetary Computer data only and the Earth Engine datasets are disabled.
# Use a dedicated, read-only service account. See README → "Turning on Earth Engine".

# Recommended: two variables from the service account key file. Serverless hosts
# (Netlify, AWS Lambda) cap all env vars at ~4 KB combined, so avoid the whole file.
GEE_CLIENT_EMAIL=
# The key's private_key, including the BEGIN/END lines. Literal \n is fine.
GEE_PRIVATE_KEY=

# Cloud project registered for Earth Engine.
GEE_PROJECT=

# Alternative for local development only: the whole key file, raw or base64.
# GEE_SERVICE_ACCOUNT_JSON=
# GEE_SERVICE_ACCOUNT_JSON_BASE64=
